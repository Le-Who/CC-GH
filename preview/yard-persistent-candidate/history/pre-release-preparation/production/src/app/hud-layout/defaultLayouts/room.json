{
  "schemaVersion": 1,
  "layoutVersion": "hud-redesign-2026-05-26",
  "gameId": "room",
  "base": {
    "regions": {
      "appTopbar": { "mode": "dock", "edge": "top", "offset": 0, "thickness": 56, "reserve": 64, "alignment": "center", "zIndex": 20, "visible": true },
      "globalStats": { "mode": "stack", "direction": "horizontal", "gap": 6, "zIndex": 20, "visible": true },
      "activeGameFrame": { "mode": "custom", "visible": true },
      "yardStage": { "mode": "custom", "visible": true },
      "yardHudLayer": { "mode": "custom", "visible": true },
      "yardCurrencyStack": { "mode": "stack", "direction": "vertical", "gap": 6, "x": 0, "y": 0, "zIndex": 30, "visible": true },
      "yardBottomDock": { "mode": "dock", "edge": "bottom", "offset": 10, "thickness": 76, "reserve": 92, "alignment": "center", "zIndex": 40, "visible": true },
      "yardGameScreen": { "mode": "anchored", "anchor": "center", "x": 0, "y": 0, "maxWidth": 640, "zIndex": 45, "visible": true },
      "yardVisitStatus": { "mode": "custom", "visible": true },
      "yardBackgroundAsset": { "mode": "freeform", "x": 0, "y": 0, "scale": 1, "opacity": 1, "rotation": 0, "visible": true }
    }
  },
  "profiles": {
    "phone-small-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 360 },
      "regions": {
        "yardBottomDock": { "thickness": 70, "reserve": 88 },
        "yardCurrencyStack": { "x": 0, "y": 0, "maxWidth": 120 },
        "yardGameScreen": { "maxWidth": 304 }
      }
    },
    "phone-default-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 430 },
      "regions": {
        "yardBottomDock": { "thickness": 74, "reserve": 92 },
        "yardGameScreen": { "maxWidth": 380 }
      }
    },
    "phone-landscape": {
      "match": { "orientation": "landscape", "maxHeight": 480 },
      "regions": {
        "yardBottomDock": { "edge": "bottom", "thickness": 58, "reserve": 68 },
        "yardCurrencyStack": { "x": 0, "y": -4 },
        "yardGameScreen": { "maxWidth": 520 }
      }
    },
    "tablet-portrait": {
      "match": { "orientation": "portrait", "minWidth": 600 },
      "regions": {
        "yardBottomDock": { "reserve": 86 },
        "yardGameScreen": { "maxWidth": 600 }
      }
    },
    "tablet-landscape": {
      "match": { "orientation": "landscape", "minWidth": 760, "maxHeight": 900 },
      "regions": {
        "yardBottomDock": { "reserve": 80 },
        "yardGameScreen": { "maxWidth": 640 }
      }
    },
    "desktop-landscape": {
      "match": { "orientation": "landscape", "minWidth": 1100 },
      "regions": {
        "yardBottomDock": { "reserve": 78 },
        "yardGameScreen": { "maxWidth": 680 }
      }
    }
  },
  "editor": {
    "notes": "Cozy Yard keeps custom activity layers and bottom HUD-launched screens; layout registers the stage, HUD layer, currency stack, dock, and dialog screen. Persistent Mika uses reserved CSS-grid header/status/nav, with the existing yardStage, yardBottomDock and editable background. Its authored camera, world projection, entry/bowl anchors and prop footprints are intentionally fixed calibration inputs shared with server preflight; editing them requires revalidating contact/route media, not a player placement override."
  }
}
