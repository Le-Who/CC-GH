{
  "schemaVersion": 1,
  "layoutVersion": "initial",
  "gameId": "blox",
  "base": {
    "regions": {
      "appTopbar": { "mode": "dock", "edge": "top", "offset": 0, "thickness": 48, "reserve": 56, "alignment": "center", "zIndex": 20, "visible": true },
      "globalStats": { "mode": "stack", "direction": "horizontal", "gap": 6, "zIndex": 20, "visible": true },
      "activeGameFrame": { "mode": "custom", "visible": true },
      "bottomDock": { "mode": "dock", "edge": "bottom", "offset": 10, "thickness": 64, "reserve": 84, "alignment": "center", "maxWidth": 1180, "zIndex": 50, "visible": true },
      "gameShell": { "mode": "custom", "visible": true },
      "gameplayHud": { "mode": "anchored", "anchor": "top-center", "x": 0, "y": 10, "maxWidth": 560, "zIndex": 40, "visible": true },
      "eventLog": { "mode": "anchored", "anchor": "bottom-center", "x": 0, "y": -104, "maxWidth": 360, "zIndex": 36, "visible": true },
      "pauseOverlay": { "mode": "anchored", "anchor": "center", "x": 0, "y": 0, "maxWidth": 390, "zIndex": 45, "visible": true },
      "pixiPlayfieldReserve": { "mode": "reserveOnly", "topReserve": 88, "bottomReserve": 116, "leftReserve": 0, "rightReserve": 0 }
    }
  },
  "profiles": {
    "phone-small-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 360 },
      "regions": {
        "gameplayHud": { "y": 6, "maxWidth": 308 },
        "eventLog": { "y": -112, "maxWidth": 304 },
        "pixiPlayfieldReserve": { "topReserve": 96, "bottomReserve": 148 }
      }
    },
    "phone-default-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 430 },
      "regions": {
        "gameplayHud": { "y": 8, "maxWidth": 380 },
        "eventLog": { "y": -108, "maxWidth": 344 },
        "pixiPlayfieldReserve": { "topReserve": 92, "bottomReserve": 132 }
      }
    },
    "phone-landscape": {
      "match": { "orientation": "landscape", "maxHeight": 480 },
      "regions": {
        "gameplayHud": { "anchor": "top-right", "x": -12, "y": 8, "maxWidth": 330 },
        "eventLog": { "anchor": "bottom-left", "x": 12, "y": -12, "maxWidth": 300 },
        "pixiPlayfieldReserve": { "topReserve": 52, "bottomReserve": 64 }
      }
    },
    "tablet-portrait": {
      "match": { "orientation": "portrait", "minWidth": 600 },
      "regions": {
        "gameplayHud": { "maxWidth": 620 },
        "pixiPlayfieldReserve": { "topReserve": 90, "bottomReserve": 112 }
      }
    },
    "tablet-landscape": {
      "match": { "orientation": "landscape", "minWidth": 760, "maxHeight": 900 },
      "regions": {
        "gameplayHud": { "maxWidth": 560 },
        "pixiPlayfieldReserve": { "topReserve": 72, "bottomReserve": 92 }
      }
    },
    "desktop-landscape": {
      "match": { "orientation": "landscape", "minWidth": 1100 },
      "regions": {
        "gameplayHud": { "maxWidth": 620 },
        "pixiPlayfieldReserve": { "topReserve": 72, "bottomReserve": 88 }
      }
    }
  },
  "editor": {
    "notes": "Blox uses shared GamePlayHud plus Pixi reserve values for the board/tray fit."
  }
}
