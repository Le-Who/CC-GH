{
  "schemaVersion": 1,
  "layoutVersion": "initial",
  "gameId": "bubbo",
  "base": {
    "regions": {
      "appTopbar": { "mode": "dock", "edge": "top", "offset": 0, "thickness": 48, "reserve": 56, "alignment": "center", "zIndex": 20, "visible": true },
      "globalStats": { "mode": "stack", "direction": "horizontal", "gap": 6, "zIndex": 20, "visible": true },
      "activeGameFrame": { "mode": "custom", "visible": true },
      "bottomDock": { "mode": "dock", "edge": "bottom", "offset": 10, "thickness": 64, "reserve": 84, "alignment": "center", "maxWidth": 1180, "zIndex": 50, "visible": true },
      "gameShell": { "mode": "custom", "visible": true },
      "gameplayHud": { "mode": "anchored", "anchor": "bottom-center", "x": 0, "y": -8, "maxWidth": 640, "zIndex": 40, "visible": true },
      "eventLog": { "mode": "anchored", "anchor": "bottom-center", "x": 0, "y": -88, "maxWidth": 360, "zIndex": 36, "visible": true },
      "pauseOverlay": { "mode": "anchored", "anchor": "center", "x": 0, "y": 0, "maxWidth": 360, "zIndex": 45, "visible": true },
      "pixiPlayfieldReserve": { "mode": "reserveOnly", "topReserve": 18, "bottomReserve": 154, "leftReserve": 0, "rightReserve": 0 }
    }
  },
  "profiles": {
    "phone-small-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 360 },
      "regions": {
        "gameplayHud": { "y": -6, "maxWidth": 308 },
        "pixiPlayfieldReserve": { "topReserve": 12, "bottomReserve": 160 }
      }
    },
    "phone-default-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 430 },
      "regions": {
        "gameplayHud": { "y": -8, "maxWidth": 380 },
        "pixiPlayfieldReserve": { "topReserve": 14, "bottomReserve": 154 }
      }
    },
    "phone-landscape": {
      "match": { "orientation": "landscape", "maxHeight": 480 },
      "regions": {
        "gameplayHud": { "anchor": "bottom-right", "x": -10, "y": -8, "maxWidth": 360 },
        "pixiPlayfieldReserve": { "topReserve": 10, "bottomReserve": 102 }
      }
    },
    "tablet-portrait": {
      "match": { "orientation": "portrait", "minWidth": 600 },
      "regions": {
        "gameplayHud": { "maxWidth": 620 },
        "pixiPlayfieldReserve": { "bottomReserve": 148 }
      }
    },
    "tablet-landscape": {
      "match": { "orientation": "landscape", "minWidth": 760, "maxHeight": 900 },
      "regions": {
        "pixiPlayfieldReserve": { "bottomReserve": 132 }
      }
    },
    "desktop-landscape": {
      "match": { "orientation": "landscape", "minWidth": 1100 },
      "regions": {
        "pixiPlayfieldReserve": { "bottomReserve": 128 }
      }
    }
  },
  "editor": {
    "notes": "Bubbo uses a bottom live HUD; Pixi gets a bottom reserve to keep cannon controls visible."
  }
}
