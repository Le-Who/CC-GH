{
  "schemaVersion": 1,
  "layoutVersion": "hud-redesign-2026-05-26",
  "gameId": "merge",
  "base": {
    "regions": {
      "appTopbar": { "mode": "dock", "edge": "top", "offset": 0, "thickness": 48, "reserve": 56, "alignment": "center", "zIndex": 20, "visible": true },
      "globalStats": { "mode": "stack", "direction": "horizontal", "gap": 6, "zIndex": 20, "visible": true },
      "activeGameFrame": { "mode": "custom", "visible": true },
      "bottomDock": { "mode": "dock", "edge": "bottom", "offset": 10, "thickness": 64, "reserve": 84, "alignment": "center", "maxWidth": 1180, "zIndex": 50, "visible": true },
      "gameShell": { "mode": "custom", "visible": true },
      "mergeSceneHud": { "mode": "anchored", "anchor": "top-center", "x": 0, "y": 6, "maxWidth": 640, "zIndex": 42, "visible": true },
      "mergeActionDock": { "mode": "dock", "edge": "bottom", "offset": 8, "thickness": 164, "reserve": 188, "alignment": "center", "maxWidth": 540, "zIndex": 42, "visible": true },
      "mergeSceneDrawer": { "mode": "anchored", "anchor": "center-right", "x": -8, "y": 0, "maxWidth": 330, "zIndex": 44, "visible": true },
      "pauseOverlay": { "mode": "anchored", "anchor": "center", "x": 0, "y": 0, "maxWidth": 390, "zIndex": 45, "visible": true },
      "pixiPlayfieldReserve": { "mode": "reserveOnly", "topReserve": 92, "bottomReserve": 188, "leftReserve": 0, "rightReserve": 0 }
    }
  },
  "profiles": {
    "phone-small-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 360 },
      "regions": {
        "mergeSceneHud": { "y": 6, "maxWidth": 348 },
        "mergeActionDock": { "thickness": 154, "reserve": 196, "maxWidth": 344 },
        "pixiPlayfieldReserve": { "topReserve": 84, "bottomReserve": 206 }
      }
    },
    "phone-default-portrait": {
      "match": { "orientation": "portrait", "maxWidth": 430 },
      "regions": {
        "mergeSceneHud": { "maxWidth": 380 },
        "mergeActionDock": { "thickness": 160, "reserve": 198, "maxWidth": 380 },
        "pixiPlayfieldReserve": { "topReserve": 88, "bottomReserve": 204 }
      }
    },
    "phone-landscape": {
      "match": { "orientation": "landscape", "maxHeight": 480 },
      "regions": {
        "mergeSceneHud": { "anchor": "top-left", "x": 10, "y": 6, "maxWidth": 330 },
        "mergeActionDock": { "edge": "right", "offset": 8, "thickness": 156, "reserve": 168, "maxWidth": 180 },
        "mergeSceneDrawer": { "anchor": "center-right", "x": -8, "y": 0, "maxWidth": 300 },
        "pixiPlayfieldReserve": { "topReserve": 62, "bottomReserve": 54, "rightReserve": 168 }
      }
    },
    "tablet-portrait": {
      "match": { "orientation": "portrait", "minWidth": 600 },
      "regions": {
        "mergeActionDock": { "reserve": 178, "maxWidth": 560 },
        "pixiPlayfieldReserve": { "topReserve": 92, "bottomReserve": 184 }
      }
    },
    "tablet-landscape": {
      "match": { "orientation": "landscape", "minWidth": 760, "maxHeight": 900 },
      "regions": {
        "pixiPlayfieldReserve": { "topReserve": 72, "bottomReserve": 172 }
      }
    },
    "desktop-landscape": {
      "match": { "orientation": "landscape", "minWidth": 1100 },
      "regions": {
        "mergeActionDock": { "reserve": 172 },
        "pixiPlayfieldReserve": { "topReserve": 72, "bottomReserve": 172 }
      }
    }
  },
  "editor": {
    "notes": "Merge uses custom in-scene HUD/dock adapters instead of GamePlayHud."
  }
}
