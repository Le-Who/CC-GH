{
  "schemaVersion": 1,
  "layoutVersion": "garden-v2-2026-10-01",
  "gameId": "garden",
  "base": {
    "regions": {
      "appTopbar": {
        "mode": "custom",
        "x": 0,
        "y": 0,
        "zIndex": 20,
        "visible": true
      },
      "globalStats": {
        "mode": "stack",
        "direction": "horizontal",
        "gap": 6,
        "x": 0,
        "y": 0,
        "zIndex": 20,
        "visible": false
      },
      "activeGameFrame": {
        "mode": "custom",
        "visible": true
      },
      "gardenRoot": {
        "mode": "custom",
        "visible": true
      },
      "gardenHomeButton": {
        "mode": "custom",
        "x": 0,
        "y": 0,
        "minWidth": 44,
        "minHeight": 48,
        "visible": true
      },
      "gardenSign": {
        "mode": "custom",
        "visible": true,
        "maxWidth": 340
      },
      "gardenShelf": {
        "mode": "custom",
        "visible": true
      },
      "gardenBottomPlank": {
        "mode": "reserveOnly",
        "topReserve": 0,
        "bottomReserve": 0,
        "leftReserve": 0,
        "rightReserve": 0
      },
      "gardenSheet": {
        "mode": "custom",
        "maxWidth": 580,
        "zIndex": 190,
        "visible": true
      },
      "gardenQuestSheet": {
        "mode": "custom",
        "maxWidth": 580,
        "zIndex": 190,
        "visible": true
      },
      "gardenComposition": {
        "mode": "custom",
        "visible": true,
        "compactWidth": 360,
        "compactHeight": 400,
        "compactPadding": 8,
        "padding": 12,
        "gap": 12,
        "landscapeMinWidth": 540,
        "railMin": 192,
        "railMax": 260,
        "railRatio": 0.26,
        "rackMax": 660,
        "spotGap": 8,
        "plantHeight": 160,
        "compactPlantHeight": 146,
        "glassInset": 12,
        "crownClearance": 34,
        "footClearance": 12,
        "nameHeight": 64,
        "metricHeight": 56,
        "headerGap": 8,
        "dialogMax": 620,
        "plantMaxHeight": 270,
        "plantHeightRatio": 0.4
      },
      "gardenStatusRail": {
        "mode": "custom",
        "visible": true
      },
      "gardenBackgroundAsset": {
        "mode": "freeform",
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0,
        "opacity": 1,
        "visible": true
      },
      "gardenSignAsset": {
        "mode": "freeform",
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0,
        "opacity": 1,
        "visible": true
      },
      "gardenShelfAsset": {
        "mode": "custom",
        "visible": true
      },
      "gardenGlassAsset": {
        "mode": "freeform",
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0,
        "opacity": 1,
        "visible": true
      },
      "gardenHudRailAsset": {
        "mode": "freeform",
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0,
        "opacity": 1,
        "visible": true
      }
    }
  },
  "profiles": {
    "phone-small-portrait": {
      "match": {
        "orientation": "portrait",
        "maxWidth": 360
      },
      "regions": {
        "globalStats": {
          "gap": 4
        }
      }
    },
    "phone-default-portrait": {
      "match": {
        "orientation": "portrait",
        "maxWidth": 430
      },
      "regions": {}
    },
    "phone-tall-portrait": {
      "match": {
        "orientation": "portrait",
        "maxWidth": 430,
        "minHeight": 880
      },
      "regions": {}
    },
    "phone-landscape": {
      "match": {
        "orientation": "landscape",
        "maxHeight": 480
      },
      "regions": {
        "appTopbar": {
          "y": -4
        },
        "globalStats": {
          "y": -4
        }
      }
    },
    "tablet-portrait": {
      "match": {
        "orientation": "portrait",
        "minWidth": 600
      },
      "regions": {}
    },
    "tablet-landscape": {
      "match": {
        "orientation": "landscape",
        "minWidth": 760,
        "maxHeight": 900
      },
      "regions": {}
    },
    "desktop-landscape": {
      "match": {
        "orientation": "landscape",
        "minWidth": 1100
      },
      "regions": {}
    }
  },
  "editor": {
    "notes": "Garden measured adapter owns portrait/landscape, rack, glass opening and plant sizing through gardenComposition. Safe areas apply once; no global dock or idle help bar. Background/sign/glass are tunable visual-only regions. One coherent nine-slice glass source preserves corners and ornaments while straight middle rails stretch. The scroller is clipped inside that closed opening. Repeated shelves preserve aspect; plant baseline follows the front plane. Name and Care share one44px action. Actionable errors use measured temporary trailing content space without moving the viewport. Shelf art remains a repeated flow-asset exception."
  }
}
