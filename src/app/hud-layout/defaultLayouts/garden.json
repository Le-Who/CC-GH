{
  "schemaVersion": 1,
  "layoutVersion": "garden-v2-2026-10-01",
  "gameId": "garden",
  "base": {
    "regions": {
      "appTopbar": {
        "mode": "custom",
        "x": 0,
        "y": 0,
        "zIndex": 20,
        "visible": true
      },
      "globalStats": {
        "mode": "stack",
        "direction": "horizontal",
        "gap": 6,
        "x": 0,
        "y": 0,
        "zIndex": 20,
        "visible": false
      },
      "activeGameFrame": {
        "mode": "custom",
        "visible": true
      },
      "gardenRoot": {
        "mode": "custom",
        "visible": true
      },
      "gardenHomeButton": {
        "mode": "custom",
        "x": 0,
        "y": 0,
        "minWidth": 44,
        "minHeight": 48,
        "visible": true
      },
      "gardenSign": {
        "mode": "custom",
        "visible": true
      },
      "gardenShelf": {
        "mode": "custom",
        "visible": true
      },
      "gardenBottomPlank": {
        "mode": "reserveOnly",
        "topReserve": 0,
        "bottomReserve": 0,
        "leftReserve": 0,
        "rightReserve": 0
      },
      "gardenSheet": {
        "mode": "custom",
        "maxWidth": 580,
        "zIndex": 190,
        "visible": true
      },
      "gardenQuestSheet": {
        "mode": "custom",
        "maxWidth": 580,
        "zIndex": 190,
        "visible": true
      },
      "gardenComposition": {
        "mode": "custom",
        "visible": true,
        "compactWidth": 360,
        "compactHeight": 400,
        "compactPadding": 8,
        "padding": 12,
        "gap": 12,
        "landscapeMinWidth": 540,
        "railMin": 192,
        "railMax": 260,
        "railRatio": 0.26,
        "rackMax": 660,
        "spotGap": 8,
        "rowHeight": 236,
        "compactRowHeight": 206,
        "plantHeight": 136,
        "compactPlantHeight": 106,
        "nameHeight": 48,
        "metricHeight": 76,
        "headerGap": 8,
        "dialogMax": 620
      },
      "gardenStatusRail": {
        "mode": "custom",
        "visible": true
      },
      "gardenBackgroundAsset": {
        "mode": "freeform",
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0,
        "opacity": 1,
        "visible": true
      },
      "gardenSignAsset": {
        "mode": "freeform",
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0,
        "opacity": 1,
        "visible": true
      },
      "gardenShelfAsset": {
        "mode": "custom",
        "visible": true
      }
    }
  },
  "profiles": {
    "phone-small-portrait": {
      "match": {
        "orientation": "portrait",
        "maxWidth": 360
      },
      "regions": {
        "globalStats": {
          "gap": 4
        }
      }
    },
    "phone-default-portrait": {
      "match": {
        "orientation": "portrait",
        "maxWidth": 430
      },
      "regions": {}
    },
    "phone-tall-portrait": {
      "match": {
        "orientation": "portrait",
        "maxWidth": 430,
        "minHeight": 880
      },
      "regions": {}
    },
    "phone-landscape": {
      "match": {
        "orientation": "landscape",
        "maxHeight": 480
      },
      "regions": {
        "appTopbar": {
          "y": -4
        },
        "globalStats": {
          "y": -4
        }
      }
    },
    "tablet-portrait": {
      "match": {
        "orientation": "portrait",
        "minWidth": 600
      },
      "regions": {}
    },
    "tablet-landscape": {
      "match": {
        "orientation": "landscape",
        "minWidth": 760,
        "maxHeight": 900
      },
      "regions": {}
    },
    "desktop-landscape": {
      "match": {
        "orientation": "landscape",
        "minWidth": 1100
      },
      "regions": {}
    }
  },
  "editor": {
    "notes": "Garden v2 measured local-area adapter owns portrait/landscape, rack and slot geometry through gardenComposition. Host applies safe areas once; Home does not reserve a global navigation dock. Background/sign are tunable visual-only regions; text/control geometry never scales with art. Shelf art repeats at a fixed row anchor with natural flow; gardenShelfAsset is a documented repeated fixed-aspect asset exception. Modal flow is measured with one scroll body. No legacy artwork coordinate slots."
  }
}
