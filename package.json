{
  "name": "game-hub",
  "version": "11.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "assets:build": "node scripts/assets-pipeline.mjs",
    "assets:readability": "node scripts/refine-readable-blox-match3-assets.mjs",
    "settlement:assets:process": "node scripts/settlement-assets.mjs process",
    "settlement:assets:audit": "node scripts/settlement-assets.mjs audit",
    "build": "pnpm run assets:build && vite build",
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev": "vite",
    "test": "node --test --test-concurrency=1 tests/assets-pipeline.test.js tests/asset-runtime.test.js tests/ui-screen-surfaces.test.js tests/settlement-assets.test.js tests/unit.test.js tests/auth.test.js tests/blox.test.js tests/bubbo.test.js tests/pointerSession.test.js tests/sceneGeometry.test.js tests/match3.test.js tests/game-ux-foundations.test.js tests/engine.test.js tests/db.test.js tests/useToast.test.js tests/useModal.test.js tests/perf.test.js tests/perf-guard.test.js tests/perf-build-guard.test.js tests/game-logic-stress.test.js tests/merge.test.js tests/i18n.test.js tests/useBloxEngine.test.js tests/gameStore.test.js tests/platform-cleanup.test.js tests/update-manager.test.js tests/operational-debt.test.js",
    "test:perf": "node --test tests/assets-pipeline.test.js tests/asset-runtime.test.js tests/perf.test.js tests/perf-guard.test.js tests/perf-build-guard.test.js",
    "perf:guard": "node scripts/perf-guard.mjs",
    "perf:guard:build": "node scripts/perf-build-guard.mjs",
    "perf:guard:browser": "playwright test tests/e2e/perf-guard.spec.js tests/e2e/assets-runtime.spec.js --project=chromium --workers=1",
    "perf:guard:all": "pnpm run perf:guard && pnpm run build && pnpm run perf:guard:build && pnpm run perf:guard:browser",
    "test:cleanup": "node scripts/check-platform-cleanup.mjs",
    "migrate:accounts": "node scripts/migrate-accounts.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.112",
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/varela-round": "^5.2.8",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.3.2",
    "@telegram-apps/sdk": "3.11.8",
    "@telegram-apps/sdk-react": "3.3.9",
    "@tma.js/init-data-node": "2.0.7",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "5.2.1",
    "framer-motion": "^12.34.3",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.2.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.575.0",
    "node-fetch": "^3.3.2",
    "pixi-filters": "^6.1.5",
    "pixi.js": "8.18.1",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "typed-signals": "^3.0.0",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "google-gax": {
      "minimatch": "^10.2.1"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
