{
  "name": "game-hub",
  "version": "7.4.0",
  "type": "module",
  "private": true,
  "description": "Unified Game Hub — Farm + Trivia + Match-3 in one Discord Activity",
  "scripts": {
    "build:vanilla": "npx esbuild src/discord-entry.js --bundle --outfile=public/js/discord-sdk-bundle.js --format=iife --global-name=DiscordSDKModule --target=es2020",
    "build": "vite build",
    "prestart": "npm run build:vanilla",
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev": "vite",
    "test": "node --test tests/unit.test.js tests/api.test.js tests/blox.test.js tests/match3.test.js tests/ux.test.js tests/gcp.test.js tests/perf.test.js tests/game-logic-stress.test.js tests/syntax.test.js",
    "test:perf": "node --test tests/perf.test.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/varela-round": "^5.2.8",
    "@google-cloud/firestore": "^8.3.0",
    "@google-cloud/storage": "^7.7.0",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "5.2.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  },
  "overrides": {
    "google-gax": {
      "minimatch": "^10.2.1"
    }
  }
}
