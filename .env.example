# Server
NODE_ENV=production
PORT=8080
APP_HOST_PORT=18080
CUSTOM_DOMAIN=games.tri.mom
PUBLIC_APP_URL=https://games.tri.mom
APP_BUILD_ID=local-dev

# Telegram Mini App
TELEGRAM_BOT_TOKEN=123456:replace-me
