# Server
NODE_ENV=production
PORT=8080
CUSTOM_DOMAIN=game.example.com
PUBLIC_APP_URL=https://game.example.com

# Telegram Mini App
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_BOT_USERNAME=your_bot_username

# VPS services
POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=gamehub
DATABASE_URL=postgresql://appuser:replace-me@postgres:5432/gamehub
REDIS_URL=redis://redis:6379

# Operations
ADMIN_TOKEN=replace-me

# Local development only. Must stay false in production.
DEV_AUTH_ENABLED=false
