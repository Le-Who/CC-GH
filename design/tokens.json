{
  "name": "Game Hub — Unified Design Tokens",
  "version": "2.0.0",
  "description": "Canonical token source merging Playful Neon direction. See design/tokens/contrast_report.md for WCAG compliance.",

  "colors": {
    "background": {
      "base": "#14151B",
      "surface": "#1E2032",
      "surfaceHover": "#2A2C42",
      "surfaceHighlight": "#343654",
      "overlay": "rgba(20, 21, 27, 0.88)"
    },
    "brand": {
      "primary": "#FF3366",
      "primaryHover": "#FF5C85",
      "primaryMuted": "rgba(255, 51, 102, 0.15)",
      "secondary": "#7289DA",
      "secondaryHover": "#8EA1E1",
      "accent": "#00FFCC",
      "accentHover": "#33FFD6",
      "accentMuted": "rgba(0, 255, 204, 0.15)"
    },
    "ui": {
      "text": "#F8F9FA",
      "textDim": "#9CA3AF",
      "textMuted": "#6B7280",
      "border": "#3A3C4E",
      "borderLight": "rgba(255, 255, 255, 0.08)",
      "gold": "#FFD700",
      "goldHover": "#FFE44D",
      "energy": "#00E5FF",
      "danger": "#FF4444",
      "dangerHover": "#FF6666",
      "success": "#00C853",
      "successHover": "#33D375",
      "info": "#4DB8FF"
    },
    "rarity": {
      "common": "#9CA3AF",
      "rare": "#60A5FA",
      "epic": "#A78BFA",
      "legendary": "#FFD700"
    },
    "farm": {
      "dirt": "#5C4033",
      "dirtHighlight": "#755444",
      "water": "#4DB8FF",
      "ready": "#39E639"
    },
    "gradients": {
      "premium": "linear-gradient(135deg, #FF3366 0%, #FF9933 100%)",
      "quest": "linear-gradient(90deg, #7289DA 0%, #00FFCC 100%)",
      "energyBar": "linear-gradient(90deg, #0088FF 0%, #00E5FF 100%)",
      "gacha": "linear-gradient(135deg, #A78BFA 0%, #8B5CF6 50%, #FF3366 100%)",
      "surface": "linear-gradient(180deg, #1E2032 0%, #14151B 100%)",
      "buttonPrimary": "linear-gradient(135deg, #FF3366 0%, #FF1A53 100%)",
      "buttonGold": "linear-gradient(135deg, #FFD700 0%, #FFC107 100%)"
    }
  },

  "shadows": {
    "neonPrimary": "0 0 10px rgba(255, 51, 102, 0.5), 0 0 20px rgba(255, 51, 102, 0.3)",
    "neonAccent": "0 0 10px rgba(0, 255, 204, 0.5), 0 0 20px rgba(0, 255, 204, 0.3)",
    "neonGold": "0 0 10px rgba(255, 215, 0, 0.5), 0 0 20px rgba(255, 215, 0, 0.3)",
    "card": "0 8px 24px rgba(0, 0, 0, 0.4)",
    "elevated": "0 12px 32px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08)",
    "button": "0 4px 0 rgba(0, 0, 0, 0.3)",
    "buttonPrimary": "0 4px 0 #9F1239, 0 8px 24px rgba(255, 51, 102, 0.35)",
    "buttonGold": "0 4px 0 #B8860B, 0 8px 24px rgba(255, 215, 0, 0.35)",
    "textGlow": "0 2px 4px rgba(0, 0, 0, 0.8)"
  },

  "typography": {
    "fontFamilies": {
      "display": "'Bungee', 'Fredoka One', system-ui, sans-serif",
      "body": "'Nunito', system-ui, sans-serif",
      "numbers": "'Varela Round', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace",
      "emoji": "'Noto Color Emoji', 'Apple Color Emoji', 'Segoe UI Emoji', sans-serif"
    },
    "googleFontsImport": "https://fonts.googleapis.com/css2?family=Bungee&family=Nunito:wght@400;600;700;800;900&family=Varela+Round&display=swap",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "hero": "3rem"
    },
    "weights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },

  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },

  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "9999px",
    "round": "50%"
  },

  "borderWidth": {
    "thin": "1px",
    "medium": "2px",
    "thick": "3px"
  },

  "motion": {
    "timing": {
      "instant": "50ms",
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms",
      "epic": "800ms"
    },
    "easing": {
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
      "bouncy": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "snappy": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "smoothOut": "cubic-bezier(0, 0, 0.2, 1)",
      "smoothIn": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "framerMotion": {
      "bouncy": { "type": "spring", "stiffness": 400, "damping": 15 },
      "smooth": { "type": "spring", "stiffness": 300, "damping": 30 },
      "snappy": { "type": "spring", "stiffness": 500, "damping": 25 }
    }
  },

  "zIndex": {
    "base": 0,
    "dropdown": 50,
    "hud": 60,
    "modal": 100,
    "toast": 150,
    "tooltip": 200
  }
}
